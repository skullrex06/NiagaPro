<resources>
    <style name="NiagaProTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#8B7CFF</item>
        <item name="android:statusBarColor">#080F2E</item>
        <item name="android:navigationBarColor">#0A1237</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:alertDialogTheme">@style/NiagaProDialog</item>
    </style>
    <style name="NiagaProDialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/niaga_dialog_bg</item>
        <item name="android:colorAccent">#8B7CFF</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#C5CEEA</item>
    </style>
</resources>